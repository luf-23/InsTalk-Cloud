spring:
  application:
    name: instalk-ai-service
  datasource:
    driver-class-name: org.postgresql.Driver
    url: ${DB_URL:jdbc:postgresql://localhost:5432/instalk}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD}
  cloud:
    nacos:
      server-addr: ${NACOS_SERVER_ADDR:localhost:8848}
      username: ${NACOS_USERNAME:nacos}
      password: ${NACOS_PASSWORD:nacos}
      discovery:
        cluster-name: ${NACOS_CLUSTER_NAME:WUHAN}
        ephemeral: true
  config:
    import:
      - optional:nacos:${spring.application.name}

server:
  port: ${SERVER_PORT:8084}

mybatis:
  configuration:
    map-underscore-to-camel-case: true

ai:
  key: ${AI_API_KEY}
  url: ${AI_API_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
  embedding-url: ${AI_EMBEDDING_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
  embedding-model: ${AI_EMBEDDING_MODEL:text-embedding-v3}
